# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
AI_ENABLED=true
AI_PROVIDER=gemini # options: gemini, ollama
GEMINI_API_KEY=your-gemini-api-key

# Local Ollama Configuration (Free / Offline option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AI Cost Control & Daily Quotas
AI_DAILY_REQUEST_LIMIT=30
MAX_RESUME_GENERATIONS_PER_DAY=5
MAX_JOB_ANALYSIS_PER_DAY=10
MAX_BULLET_REWRITES_PER_DAY=20
MAX_GITHUB_ANALYSES_PER_DAY=10
MAX_DOCUMENT_ANALYSES_PER_DAY=10
MAX_ATS_ANALYSES_PER_DAY=10

# GitHub Integration (OAuth or Personal Access Token for MVP repo ingestion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional Vector Database (Functional without it via PostgreSQL keyword/structured matching)
QDRANT_URL=
QDRANT_API_KEY=
